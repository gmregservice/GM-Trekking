<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rete: per interrogare Overpass API e scaricare tile mappa -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Localizzazione: obbligatoria per la navigazione GPS sul tracciato -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Necessarie per tenere il GPS attivo durante il trekking a schermo spento -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Richiesta da Android 13+ per mostrare la notifica del servizio in foreground -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sensore contapassi durante la registrazione del cammino: richiesta solo da Android 10+ -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <application
        android:name=".GMTrekkingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GMTrekking">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GMTrekking">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Schermata di crash (vedi crash/CrashHandler.kt). android:process=":crash"
          la fa girare in un processo separato da quello principale: è importante,
          perché CrashHandler termina il processo principale (quello andato in
          crash) subito dopo averla aperta, e se girasse nello stesso processo
          rischierebbe di essere chiusa insieme a lui prima di riuscire a comparire.
        -->
        <activity
            android:name=".crash.CrashReportActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.GMTrekking" />

        <!--
          Servizio in foreground per il tracciamento GPS durante la navigazione.
          android:foregroundServiceType="location" è obbligatorio da Android 14 (API 34).
        -->
        <service
            android:name=".location.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
