<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rete: per interrogare Overpass API e scaricare tile mappa -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Localizzazione: obbligatoria per la navigazione GPS sul tracciato -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Necessarie per tenere il GPS attivo durante il trekking a schermo spento -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Richiesta da Android 13+ per mostrare la notifica del servizio in foreground -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sensore contapassi durante la registrazione del cammino: richiesta solo da Android 10+ -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <!--
      Foto geolocalizzate (punto 3 del piano): la fotocamera viene aperta
      tramite intent verso l'app di sistema, non con l'API Camera diretta —
      per questo NON serve il permesso CAMERA in manifest (lo gestisce l'app
      Fotocamera). required="false": l'app deve restare utilizzabile anche
      su un dispositivo senza fotocamera, semplicemente senza poter aggiungere foto.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".GMTrekkingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GMTrekking">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GMTrekking">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Schermata di crash (vedi crash/CrashHandler.kt). android:process=":crash"
          la fa girare in un processo separato da quello principale: è importante,
          perché CrashHandler termina il processo principale (quello andato in
          crash) subito dopo averla aperta, e se girasse nello stesso processo
          rischierebbe di essere chiusa insieme a lui prima di riuscire a comparire.
        -->
        <activity
            android:name=".crash.CrashReportActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.GMTrekking" />

        <!--
          Servizio in foreground per il tracciamento GPS durante la navigazione.
          android:foregroundServiceType="location" è obbligatorio da Android 14 (API 34).
        -->
        <service
            android:name=".location.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          FileProvider per condividere con l'app Fotocamera di sistema il file
          dove salvare lo scatto (foto geolocalizzate, punto 3 del piano):
          senza un Uri "content://" ottenuto così, l'app Fotocamera non può
          scrivere in un file nella cartella privata di GM-Trekking, e
          ACTION_IMAGE_CAPTURE restituirebbe solo un'anteprima a bassa
          risoluzione invece della foto intera. Vedi data/tracking/PhotoStorage.kt.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
